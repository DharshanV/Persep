<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Persep" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorControlActivated">@color/persep_color</item>
        <item name="materialAlertDialogTheme">@style/Theme.Persep.DialogAlert</item>
    </style>

    <style name="Theme.Persep.UCrop" parent="Theme.Persep">
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Theme.Persep.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke_color</item>
        <item name="hintTextColor">@color/text_color_on_background</item>
        <item name="android:textColorHint">@color/text_color_on_background</item>
    </style>

    <style name="Theme.Persep.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/persep_color</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.Persep.DialogAlert" parent="@style/ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Persep.AlertButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Persep.AlertButtonStyle</item>
    </style>

    <style name="Theme.Persep.AlertButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/persep_color</item>
        <item name="rippleColor">@color/button_ripple_color</item>
    </style>

    <style name="Theme.Persep.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/black</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/bottom_navigation_icon_color</item>
        <item name="itemRippleColor">@color/button_ripple_color</item>
        <item name="itemIconSize">30dp</item>
    </style>

    <style name="Theme.Persep.AccountSettingButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="iconGravity">end</item>
        <item name="android:gravity">center|left</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="textAllCaps">false</item>
        <item name="iconTint">@color/persep_color</item>
        <item name="rippleColor">@color/button_ripple_color</item>
    </style>

    <style name="Theme.Persep.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="iconTint">@color/persep_color</item>
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="rippleColor">@color/button_ripple_color</item>
    </style>

    <style name="Theme.Persep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_persep_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="postSplashScreenTheme">@style/Theme.Persep</item>
    </style>
</resources>