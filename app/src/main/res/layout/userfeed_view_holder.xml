<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="10dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/post_rounded_background">

        <RelativeLayout
            android:id="@+id/user_feed_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/user_feed_post_image"
            app:layout_constraintLeft_toLeftOf="parent">

            <TextView
                android:id="@+id/user_post_geo_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:background="@color/black"
                android:fontFamily="@font/roboto_italic"
                android:text="Kingsford, New South Wales"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_options_button"
                style="@style/Theme.Persep.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                app:icon="@drawable/ic_baseline_menu_24"
                app:iconSize="27dp"
                app:iconTint="@color/white" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/user_feed_post_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_feed_top_bar"
            android:background="@color/black"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/user_feed_post_image">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_post_like_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:icon="@drawable/ic_heart_24"
                app:iconSize="27dp"
                app:iconTint="@color/red_heart"
                app:rippleColor="@color/button_ripple_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_post_comment_image"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                app:icon="@drawable/ic_baseline_mode_comment_24"
                app:iconTint="@color/white"
                app:iconSize="27dp"
                app:iconGravity="textEnd"
                android:text="0"
                android:textSize="18sp"
                android:textColor="@color/white"
                app:rippleColor="@color/button_ripple_color"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
