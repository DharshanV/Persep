<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="55dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:layout_gravity="center"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_baseline_account_circle_24"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <TextView
            android:id="@+id/post_comment_username_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:text="TempUserName"
            android:textColor="@color/text_color_on_background"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/post_comment_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/post_comment_username_text_view"
            android:fontFamily="@font/roboto_regular"
            android:text="Temp message"
            android:textSize="17sp"
            android:textColor="@color/text_color_on_background" />

    </RelativeLayout>
</LinearLayout>