<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/appintro_statusbar_height"
        android:layout_marginBottom="@dimen/appintro2_bottombar_height"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/image_1"
            android:fontFamily="@font/playfair_display_bold"
            android:gravity="center"
            android:text="Creating a Post"
            android:textColor="@color/text_color_on_background"
            android:textSize="35sp" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/image_1"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/test_gif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/image_1"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:text="Take a photo, edit it, and post. This will either create a new album or add to existing nearby album."
            android:textColor="@color/text_color_on_background"
            android:textSize="18sp" />

    </RelativeLayout>

</FrameLayout>