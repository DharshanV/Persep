<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.perception.persep.activities.SettingsActivity">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back_settings"
        style="@style/Theme.Persep.IconButton"
        app:icon="@drawable/ic_baseline_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp" />

    <TextView
        android:id="@+id/setting_activity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|left"
        android:fontFamily="@font/playfair_display_bold"
        android:gravity="center"
        android:text="@string/profile_activity_title_string"
        android:textSize="35sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_back_settings"
        tools:ignore="RtlHardcoded" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_sign_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/rounded_button"
        android:textColor="@color/button_text_color"
        android:padding="15dp"
        android:text="@string/sign_out_string"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/setting_activity_title" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_delete_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/rounded_button_delete_account"
        android:textColor="@color/button_text_color_delete_account"
        android:padding="15dp"
        android:text="@string/delete_account_string"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/button_sign_out" />
</androidx.constraintlayout.widget.ConstraintLayout>