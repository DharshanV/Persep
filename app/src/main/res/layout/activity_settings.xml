<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.perception.persep.activities.SettingsActivity">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back_settings"
        style="@style/Theme.Persep.IconButton"
        app:icon="@drawable/ic_baseline_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/button_back_settings"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/lora_bold"
                android:text="@string/profile_activity_title_string"
                android:textSize="35sp"
                android:textColor="@color/text_color_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/activity_settings_username_email_string"
                android:textSize="15sp"
                android:textColor="#AFAFAF"
                android:fontFamily="@font/lora_bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <TextView
                android:id="@+id/account_settings_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="TempUsername"
                android:textSize="20sp"
                android:textColor="@color/text_color_on_background"
                android:fontFamily="@font/lora_regular"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <TextView
                android:id="@+id/account_settings_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="temp@gmail.com"
                android:textSize="20sp"
                android:textColor="@color/text_color_on_background"
                android:fontFamily="@font/lora_regular"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/activity_settings_legal_string"
                android:textSize="15sp"
                android:textColor="#AFAFAF"
                android:fontFamily="@font/lora_bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_settings_privacy_policy_button"
                style="@style/Theme.Persep.AccountSettingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_chevron_right_24"
                android:text="@string/account_settings_privacy_policy_button_string"
                android:fontFamily="@font/lora_regular"
                android:textColor="@color/text_color_on_background"
                android:textSize="19sp"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_settings_terms_of_service_button"
                style="@style/Theme.Persep.AccountSettingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_chevron_right_24"
                android:text="@string/account_settings_terms_of_service_button_string"
                android:fontFamily="@font/lora_regular"
                android:textColor="@color/text_color_on_background"
                android:textSize="19sp"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="Account"
                android:textSize="15dp"
                android:textColor="#AFAFAF"
                android:fontFamily="@font/lora_bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_settings_sign_out_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_logout_24"
                app:iconTint="@color/persep_color"
                app:rippleColor="@color/button_ripple_color"
                app:iconGravity="textStart"
                android:text="@string/account_settings_sign_out_button_string"
                android:fontFamily="@font/lora_regular"
                android:textColor="@color/text_color_on_background"
                android:textSize="19sp"
                android:letterSpacing="0"
                android:textAllCaps="false"
                tools:ignore="RtlSymmetry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="7dp"
                android:background="@color/quantum_grey600"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_settings_delete_account_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_delete_24"
                app:iconTint="@color/persep_color"
                app:rippleColor="@color/button_ripple_color"
                app:iconGravity="textStart"
                android:text="@string/account_settings_delete_account_button_string"
                android:fontFamily="@font/lora_regular"
                android:textColor="@color/text_color_on_background"
                android:textSize="19sp"
                android:letterSpacing="0"
                android:textAllCaps="false"
                tools:ignore="RtlSymmetry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:background="@color/quantum_grey600"/>
        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>