<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/ic_baseline_drag_handle_24"
        android:id="@+id/feed_popup_popup_drag_view"/>

    <TextView
        android:id="@+id/feed_popup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="25sp"
        android:gravity="center"
        android:fontFamily="sans-serif-light"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/feed_popup_popup_drag_view"
        />

    <View
        android:id="@+id/divier1"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/divider_background_color"
        app:layout_constraintTop_toBottomOf="@id/feed_popup_title"/>

    <ListView
        android:id="@+id/feed_popup_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/divier1"
        app:layout_constraintBottom_toBottomOf="parent"
        android:listSelector="@android:color/transparent"/>

    <TextView
        android:id="@+id/user_feed_popup_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/feed_popup_list_view"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>