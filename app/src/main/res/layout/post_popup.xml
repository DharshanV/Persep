<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/ic_baseline_drag_handle_24"
        android:id="@+id/popup_drag_view"/>

    <TextView
        android:id="@+id/popup_username_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:text="Username"
        android:layout_marginStart="10dp"
        android:layout_gravity="center|left"
        android:fontFamily="@font/playfair_display_bold"
        tools:ignore="RtlHardcoded"
        app:layout_constraintTop_toBottomOf="@+id/popup_drag_view"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/temp_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/rounded_button"
        android:textColor="@color/button_text_color"
        android:padding="15dp"
        android:text="@string/login_button_login_text"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/popup_username_text_view" />

</androidx.constraintlayout.widget.ConstraintLayout>