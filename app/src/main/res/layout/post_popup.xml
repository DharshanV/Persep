<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/ic_baseline_drag_handle_24"
        android:id="@+id/popup_drag_view"/>

    <TextView
        android:id="@+id/popup_username_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:text="Username"
        android:textColor="@color/text_color_on_background"
        android:layout_marginStart="10dp"
        android:layout_gravity="center|left"
        android:fontFamily="@font/lora_bold"
        tools:ignore="RtlHardcoded"
        app:layout_constraintTop_toBottomOf="@+id/popup_drag_view"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <TextView
        android:id="@+id/popup_post_data_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="Yesterday, 8:30 pm"
        android:textSize="17sp"
        android:textColor="@color/text_color_on_background"
        android:fontFamily="@font/roboto_regular"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/popup_drag_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divier1"/>

    <View
        android:id="@+id/divier1"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/divider_background_color"
        app:layout_constraintTop_toBottomOf="@id/popup_username_text_view"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divier1"
        android:src="@mipmap/icon_launcher_persep"
        android:id="@+id/popup_user_post_image"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/popup_post_like_count"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:layout_marginStart="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divier2"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:icon="@drawable/ic_heart_24"
        app:iconSize="27dp"
        app:iconTint="@color/red_heart"
        app:rippleColor="@color/button_ripple_color"
        android:enabled="false"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/popup_post_comment_count"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:icon="@drawable/ic_baseline_mode_comment_24"
        app:iconTint="@color/white"
        app:iconSize="27dp"
        app:iconGravity="textEnd"
        android:text="0"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:rippleColor="@color/button_ripple_color"
        android:enabled="false"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divier2"/>

    <View
        android:id="@+id/divier2"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/divider_background_color"
        app:layout_constraintTop_toBottomOf="@id/popup_user_post_image"/>

    <ListView
        android:id="@+id/popup_post_comments_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/divier2"
        app:layout_constraintBottom_toTopOf="@id/popup_message_send_layout"
        android:listSelector="@android:color/transparent">
    </ListView>

    <TextView
        android:id="@+id/popup_empty_view"
        android:textColor="@color/text_color_on_background"
        android:textSize="20sp"
        android:fontFamily="@font/roboto_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/popup_post_comments_list"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/popup_message_send_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/popup_send_comment_edit_text"
            android:backgroundTint="@color/persep_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:hint="Comment"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popup_send_comment_button"
            style="@style/Theme.Persep.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_baseline_send_24"
            app:iconSize="30dp"
            app:iconTint="@color/persep_color" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>