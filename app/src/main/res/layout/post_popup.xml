<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/ic_baseline_drag_handle_24"
        android:id="@+id/popup_drag_view"/>

    <TextView
        android:id="@+id/popup_username_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:text="Username"
        android:layout_marginStart="10dp"
        android:layout_gravity="center|left"
        android:fontFamily="@font/playfair_display_bold"
        tools:ignore="RtlHardcoded"
        app:layout_constraintTop_toBottomOf="@+id/popup_drag_view"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <View
        android:id="@+id/divier1"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/divider_background_color"
        app:layout_constraintTop_toBottomOf="@id/popup_username_text_view"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divier1"
        android:src="@mipmap/icon_launcher_persep"
        android:id="@+id/popup_user_post_image"/>

    <ListView
        android:id="@+id/popup_post_comments_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/popup_user_post_image"
        app:layout_constraintBottom_toTopOf="@id/popup_message_send_layout">
    </ListView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/popup_message_send_layout">

        <EditText
            android:id="@+id/popup_send_message_edit_text"
            android:layout_width="0dp"
            android:layout_weight="0.85"
            android:layout_height="wrap_content"
            android:hint="@string/popup_message_edit_text_hint_string"
            android:inputType="textShortMessage"/>

        <ImageButton
            android:id="@+id/popup_send_message_button"
            android:layout_width="0dp"
            android:layout_weight="0.15"
            android:layout_height="match_parent"
            android:src="@drawable/ic_baseline_send_24"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>