<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vr_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Persep"
    android:background="@color/black"
    tools:context="com.perception.persep.fragments.VR_Fragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="15dp"
        android:paddingTop="30dp"
        android:paddingBottom="25dp"
        android:paddingHorizontal="5dp"
        android:background="@drawable/ar_icon_background"
        android:translationZ="30dp">

        <ImageButton
            android:id="@+id/toggle_camera_button"
            android:layout_width="@dimen/vr_enable_disable_vector_size"
            android:layout_height="@dimen/vr_enable_disable_vector_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_baseline_camera_rear_24"
            android:translationZ="30dp" />

        <ImageButton
            android:layout_marginTop="20dp"
            android:id="@+id/toggle_vr_button"
            android:layout_width="@dimen/vr_enable_disable_vector_size"
            android:layout_height="@dimen/vr_enable_disable_vector_size"
            app:layout_constraintTop_toBottomOf="@id/toggle_camera_button"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_ar_enabled_button"
            android:translationZ="30dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/vr_button_take_photo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/vr_rounded_button"
        android:translationZ="30dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>