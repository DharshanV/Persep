<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vr_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Persep.Home"
    tools:context="com.perception.persep.fragments.VR_Fragment">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/vr_button_take_photo"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="35dp"
        android:layout_marginLeft="135dp"
        android:layout_marginRight="135dp"
        android:background="@drawable/rounded_button"
        android:layout_gravity="center|bottom"
        android:translationZ="30dp"/>

    <ImageButton
        android:id="@+id/toggle_vr_button"
        android:layout_width="@dimen/vr_enable_disable_vector_size"
        android:layout_height="@dimen/vr_enable_disable_vector_size"
        android:background="@android:color/transparent"
        android:src="@drawable/vr_enable_card_outline"
        android:layout_marginTop="60dp"
        android:layout_marginRight="10dp"
        android:layout_gravity="right|top"
        android:translationZ="30dp"/>
</FrameLayout>